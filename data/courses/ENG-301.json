  "modules": [
    {
      "id": "ENG-301-U01",
      "title": "Producción y reservas",
      "subtitle": "UNIDAD 01 · ENG-301",
      "blocks": [
        {
          "type": "p",
          "text": "El estado energético se entiende mediante fuentes activas, reservas, consumo, margen disponible, prioridades y degradaciones."
        },
        {
          "type": "definition",
          "term": "Reservas",
          "text": "Capacidad para absorber picos y contingencias; no son infinitas."
        },
        {
          "type": "definition",
          "term": "Margen",
          "text": "Capacidad disponible antes de comprometer estabilidad, reservas u otros consumidores."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué forma el estado energético?",
            "¿Para qué sirven reservas?",
            "¿Por qué no son infinitas?",
            "Nombra consumidores importantes.",
            "¿Qué significa margen?"
          ]
        }
      ]
    },
    {
      "id": "ENG-301-U02",
      "title": "Distribución de energía",
      "subtitle": "UNIDAD 02 · ENG-301",
      "blocks": [
        {
          "type": "p",
          "text": "Distribuir energía significa mantener, aumentar, reducir, aislar o redirigir capacidad hacia cargas concretas."
        },
        {
          "type": "heading",
          "text": "Prioridades"
        },
        {
          "type": "bullets",
          "items": [
            "Seguridad",
            "Misión",
            "Mando",
            "Emergencia",
            "Estado técnico"
          ]
        },
        {
          "type": "callout",
          "label": "RECURSO COMPARTIDO",
          "text": "Aumentar un sistema puede reducir capacidad disponible para otro."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué significa distribuir energía?",
            "¿De dónde vienen prioridades?",
            "¿Qué ocurre con una ruta dañada?",
            "¿Para qué sirve aislar?",
            "¿Por qué una reasignación tiene coste?"
          ]
        }
      ]
    },
    {
      "id": "ENG-301-U03",
      "title": "Propulsión y energía",
      "subtitle": "UNIDAD 03 · ENG-301",
      "blocks": [
        {
          "type": "p",
          "text": "Una orden de vuelo tiene coste técnico. Ingeniería debe informar si es posible, cuánto puede sostenerse, qué riesgo existe y qué efecto tiene sobre otros sistemas."
        },
        {
          "type": "definition",
          "term": "Máximo",
          "text": "Capacidad pico disponible en condiciones concretas."
        },
        {
          "type": "definition",
          "term": "Sostenible",
          "text": "Capacidad que puede mantenerse durante un periodo razonable."
        },
        {
          "type": "callout",
          "label": "INFORME ÚTIL",
          "text": "«Warp 8 disponible durante 12 minutos; warp 7 sostenible» es más útil que un simple «no»."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué debe responder Ingeniería?",
            "Diferencia máximo y sostenible.",
            "¿Qué limita warp?",
            "¿Qué es capacidad de emergencia?",
            "¿Cómo se reporta una limitación?"
          ]
        }
      ]
    },
    {
      "id": "ENG-301-U04",
      "title": "Dependencias de sistemas",
      "subtitle": "UNIDAD 04 · ENG-301",
      "blocks": [
        {
          "type": "p",
          "text": "Los sistemas dependen de energía, datos, refrigeración, control, hardware y autorización."
        },
        {
          "type": "heading",
          "text": "Ejemplos"
        },
        {
          "type": "bullets",
          "items": [
            "Sensores: matrices, potencia, integridad y procesamiento",
            "Escudos: recursos y estado",
            "Transportadores: energía, condiciones, objetivo y autorización",
            "Soporte vital: habitabilidad y seguridad"
          ]
        },
        {
          "type": "callout",
          "label": "EFECTO CASCADA",
          "text": "Un fallo de distribución puede degradar Sensores y aumentar la incertidumbre de Navegación."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "Nombra dependencias posibles.",
            "¿De qué depende Sensores?",
            "¿Por qué soporte vital tiene alta prioridad?",
            "¿Qué limita transportadores?",
            "Explica un efecto cascada."
          ]
        }
      ]
    },
    {
      "id": "ENG-301-U05",
      "title": "Mantenimiento y diagnóstico básico",
      "subtitle": "UNIDAD 05 · ENG-301",
      "blocks": [
        {
          "type": "callout",
          "label": "SÍNTOMA ≠ CAUSA",
          "text": "«La matriz pierde resolución» describe un síntoma. Daño, potencia, calibración o interferencia pueden ser causas distintas."
        },
        {
          "type": "heading",
          "text": "Diagnóstico básico"
        },
        {
          "type": "numbered",
          "items": [
            "Confirmar síntoma",
            "Consultar estado",
            "Ejecutar prueba",
            "Comparar",
            "Aislar causa probable",
            "Actuar o escalar"
          ]
        },
        {
          "type": "heading",
          "text": "Acciones"
        },
        {
          "type": "bullets",
          "items": [
            "Diagnosticar",
            "Redirigir energía",
            "Aislar",
            "Reiniciar",
            "Asignar reparación",
            "Parche temporal",
            "Sustituir componente",
            "Ejecutar prueba"
          ]
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "Diferencia síntoma y causa.",
            "¿Qué pasos sigue diagnóstico?",
            "Nombra cuatro acciones.",
            "¿Qué limita al cadete?",
            "¿Cuándo debe escalar?"
          ]
        }
      ]
    },
    {
      "id": "ENG-301-U06",
      "title": "Informe de Ingeniería",
      "subtitle": "UNIDAD 06 · ENG-301",
      "blocks": [
        {
          "type": "p",
          "text": "El puente necesita un informe técnico que describa estado, capacidad, riesgo, tiempo estimado y restricciones."
        },
        {
          "type": "heading",
          "text": "Estados útiles"
        },
        {
          "type": "bullets",
          "items": [
            "Normal",
            "Degradado",
            "Limitado",
            "Crítico",
            "Fuera de servicio"
          ]
        },
        {
          "type": "p",
          "text": "Una ETA técnica debe expresar incertidumbre cuando corresponda. Ingeniería puede recomendar una opción; Mando decide cuando la cuestión excede la autoridad técnica."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué necesita saber el puente?",
            "¿Por qué «está mal» no sirve?",
            "¿Qué significa informar capacidad?",
            "¿Qué acompaña una ETA incierta?",
            "¿Quién decide cuando excede Ingeniería?"
          ]
        }
      ]
    }
  ],
  "status": "developed_content"
}
