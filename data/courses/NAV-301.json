  ],
  "modules": [
    {
      "id": "NAV-301-U01",
      "title": "Estación de vuelo",
      "subtitle": "UNIDAD 01 · NAV-301",
      "blocks": [
        {
          "type": "p",
          "text": "La estación de vuelo transforma una intención de mando en una solución validada de movimiento. Trabaja con rumbo, velocidad, propulsión, maniobra y ejecución."
        },
        {
          "type": "heading",
          "text": "Acciones funcionales mínimas"
        },
        {
          "type": "bullets",
          "items": [
            "Fijar rumbo",
            "Seleccionar velocidad",
            "Entrar/salir de warp",
            "Interceptar",
            "Entrar en órbita",
            "Aproximarse",
            "Atracar cuando proceda",
            "Abortar o cancelar"
          ]
        },
        {
          "type": "callout",
          "label": "VALIDACIÓN",
          "text": "Una orden puede ser válida como intención pero no ejecutable con el estado actual de la nave."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué controla la estación de vuelo?",
            "¿Qué información necesita?",
            "Nombra cuatro acciones mínimas.",
            "Diferencia orden válida y ejecutable.",
            "¿Qué haces si la nave no puede cumplir?"
          ]
        }
      ]
    },
    {
      "id": "NAV-301-U02",
      "title": "Plotting operativo",
      "subtitle": "UNIDAD 02 · NAV-301",
      "blocks": [
        {
          "type": "p",
          "text": "Plotting construye una solución de navegación entre origen y destino teniendo en cuenta waypoints, restricciones, peligros conocidos, preferencias y ETA."
        },
        {
          "type": "definition",
          "term": "Waypoint",
          "text": "Punto intermedio que estructura una ruta para evitar zonas, buscar apoyo o cumplir condiciones."
        },
        {
          "type": "heading",
          "text": "Preferencias"
        },
        {
          "type": "bullets",
          "items": [
            "Más rápida",
            "Más segura",
            "Evitar espacio hostil",
            "Evitar espacio restringido",
            "Preferir apoyo",
            "Bajo contacto"
          ]
        },
        {
          "type": "callout",
          "label": "FÍSICA Y POLÍTICA",
          "text": "Una ruta puede ser físicamente posible y aun así estar políticamente restringida."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué significa plotting?",
            "¿Para qué sirve un waypoint?",
            "Nombra tres preferencias.",
            "¿Por qué la ruta corta no siempre es mejor?",
            "Diferencia posibilidad física y legalidad."
          ]
        }
      ]
    },
    {
      "id": "NAV-301-U03",
      "title": "Maniobra a impulso",
      "subtitle": "UNIDAD 03 · NAV-301",
      "blocks": [
        {
          "type": "p",
          "text": "La maniobra a impulso cubre control subluz cercano: cambios de rumbo, velocidad, aproximación, separación y otras maniobras locales."
        },
        {
          "type": "heading",
          "text": "Qué se valida"
        },
        {
          "type": "bullets",
          "items": [
            "Capacidad de maniobra",
            "Obstáculos",
            "Trayectorias",
            "Estado de propulsión",
            "Restricciones"
          ]
        },
        {
          "type": "p",
          "text": "Aumentar velocidad puede reducir margen de reacción y dificultar una aproximación segura."
        },
        {
          "type": "callout",
          "label": "CANCELACIÓN",
          "text": "Toda maniobra debe poder modificarse o cancelarse si cambia la situación."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué tareas pertenecen a impulso?",
            "¿Qué valida un cambio de rumbo?",
            "¿Qué puede empeorar al aumentar velocidad?",
            "¿De qué dependen los márgenes?",
            "¿Por qué debe existir cancelación?"
          ]
        }
      ]
    },
    {
      "id": "NAV-301-U04",
      "title": "Curso warp",
      "subtitle": "UNIDAD 04 · NAV-301",
      "blocks": [
        {
          "type": "p",
          "text": "Entrar en warp exige destino, ruta, factor solicitado, capacidad sostenible, energía, estado de daños, restricciones y autorización."
        },
        {
          "type": "callout",
          "label": "TRÁNSITO PERSISTENTE",
          "text": "Entrar en warp inicia el viaje; no completa el trayecto instantáneamente."
        },
        {
          "type": "heading",
          "text": "Monitorización"
        },
        {
          "type": "bullets",
          "items": [
            "Posición",
            "Progreso",
            "ETA",
            "Propulsión",
            "Condiciones",
            "Cambios de ruta",
            "Nuevos peligros conocidos"
          ]
        },
        {
          "type": "p",
          "text": "Daño, energía, condiciones subespaciales, fronteras o cambios de misión pueden obligar a replanificar."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué se comprueba antes de warp?",
            "¿Por qué no completa el viaje?",
            "¿Qué se monitoriza?",
            "Nombra causas de salida o replanificación.",
            "¿Qué cambia una ETA?"
          ]
        }
      ]
    },
    {
      "id": "NAV-301-U05",
      "title": "Aproximación y órbita",
      "subtitle": "UNIDAD 05 · NAV-301",
      "blocks": [
        {
          "type": "definition",
          "term": "Interceptación",
          "text": "Trayectoria destinada a encontrarse con un objetivo móvil."
        },
        {
          "type": "p",
          "text": "La aproximación controla velocidad relativa, separación, orientación, tráfico e instrucciones del destino."
        },
        {
          "type": "p",
          "text": "Entrar en órbita requiere cuerpo objetivo, solución válida y capacidad de control. No se exige calcular mecánica orbital real manualmente."
        },
        {
          "type": "heading",
          "text": "Acoplamiento"
        },
        {
          "type": "bullets",
          "items": [
            "Instalación válida",
            "Puerto asignado cuando proceda",
            "Aproximación segura",
            "Autorización"
          ]
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué datos requiere interceptar?",
            "¿Qué controla una aproximación?",
            "¿Qué necesita una orden de órbita?",
            "¿Qué añade el acoplamiento?",
            "¿Para qué sirven los márgenes?"
          ]
        }
      ]
    },
    {
      "id": "NAV-301-U06",
      "title": "Anomalías de navegación",
      "subtitle": "UNIDAD 06 · NAV-301",
      "blocks": [
        {
          "type": "p",
          "text": "Una anomalía aparece cuando la nave se desvía de la solución prevista o cuando la ruta deja de ser válida."
        },
        {
          "type": "heading",
          "text": "Causas"
        },
        {
          "type": "bullets",
          "items": [
            "Daño",
            "Error",
            "Nueva información",
            "Cambio de condiciones",
            "Obstáculo",
            "Orden modificada"
          ]
        },
        {
          "type": "p",
          "text": "Con datos incompletos se reduce confianza, se amplían márgenes y se solicita información; no se finge precisión."
        },
        {
          "type": "callout",
          "label": "ABORTAR PUEDE SER CORRECTO",
          "text": "Si continuar deja de ser seguro o autorizado, abortar es una decisión profesional, no un fracaso automático."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué causa una desviación?",
            "¿Cómo trabajas con datos incompletos?",
            "¿Qué consideras ante un obstáculo?",
            "¿Cuándo es correcto abortar?",
            "¿Qué incluye el reporte de anomalía?"
          ]
        }
      ]
    }
  ],
  "status": "developed_content"
}
