  "modules": [
    {
      "id": "XEN-302-U01",
      "title": "Diferencia biológica y cultural",
      "subtitle": "UNIDAD 01 · XEN-302",
      "blocks": [
        {
          "type": "p",
          "text": "Biología, cultura, costumbre e individuo son capas distintas. Una tendencia cultural puede orientar una pregunta, pero no predecir automáticamente a la persona."
        },
        {
          "type": "definition",
          "term": "Biología",
          "text": "Características fisiológicas de una especie."
        },
        {
          "type": "definition",
          "term": "Cultura",
          "text": "Valores, normas y prácticas compartidas."
        },
        {
          "type": "definition",
          "term": "Costumbre",
          "text": "Práctica concreta dentro de un grupo."
        },
        {
          "type": "definition",
          "term": "Individuo",
          "text": "Persona con historia y decisiones propias."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "Diferencia las cuatro capas.",
            "¿Qué convierte una generalización en estereotipo?",
            "¿Por qué existe variación interna?",
            "¿Qué error aparece al confundir biología y cultura?",
            "¿Cómo se usa conocimiento cultural previo?"
          ]
        }
      ]
    },
    {
      "id": "XEN-302-U02",
      "title": "Comunicación intercultural",
      "subtitle": "UNIDAD 02 · XEN-302",
      "blocks": [
        {
          "type": "p",
          "text": "El contexto, jerarquía, formalidad, relación y situación pueden cambiar el significado social de un mensaje."
        },
        {
          "type": "heading",
          "text": "Ante un malentendido"
        },
        {
          "type": "numbered",
          "items": [
            "No atribuir intención negativa de inmediato",
            "Revisar contexto",
            "Pedir aclaración",
            "Adaptar forma",
            "Registrar si es operativamente relevante"
          ]
        },
        {
          "type": "callout",
          "label": "ESCUCHA",
          "text": "Escuchar implica confirmar, resumir, preguntar y reconocer ambigüedad."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué cambia el significado social?",
            "¿Por qué tono puede variar?",
            "Nombra tabúes posibles.",
            "¿Qué pasos ayudan ante malentendido?",
            "¿Qué implica escucha profesional?"
          ]
        }
      ]
    },
    {
      "id": "XEN-302-U03",
      "title": "Protocolo básico",
      "subtitle": "UNIDAD 03 · XEN-302",
      "blocks": [
        {
          "type": "p",
          "text": "Antes de un encuentro formal conviene revisar participantes, autoridad, propósito, protocolo conocido, símbolos relevantes y límites de seguridad."
        },
        {
          "type": "heading",
          "text": "Hospitalidad y símbolos"
        },
        {
          "type": "p",
          "text": "Comida, regalos, emblemas o posición en una sala pueden tener significado ritual o político; no se presumen neutrales."
        },
        {
          "type": "callout",
          "label": "PRUDENCIA",
          "text": "Cuando existe duda, es preferible una forma formal y prudente hasta confirmar el protocolo."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué conviene conocer antes de un encuentro?",
            "¿Por qué una forma prudente ayuda?",
            "¿Qué significados puede tener hospitalidad?",
            "¿Por qué importan símbolos?",
            "¿Es universal el espacio personal?"
          ]
        }
      ]
    },
    {
      "id": "XEN-302-U04",
      "title": "Traductor Universal y límites",
      "subtitle": "UNIDAD 04 · XEN-302",
      "blocks": [
        {
          "type": "p",
          "text": "El Traductor Universal ayuda a convertir lenguaje, pero no garantiza equivalencia perfecta, comprensión cultural o intención correcta."
        },
        {
          "type": "heading",
          "text": "Fuentes de ambigüedad"
        },
        {
          "type": "bullets",
          "items": [
            "Polisemia",
            "Ironía",
            "Uso ritual",
            "Referencia histórica",
            "Conceptos sin equivalente"
          ]
        },
        {
          "type": "callout",
          "label": "SEÑAL DE ALERTA",
          "text": "Una respuesta ilógica o un término que cambia de sentido puede indicar problema de traducción."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué no garantiza el Traductor Universal?",
            "¿Qué crea ambigüedad?",
            "¿Qué hacer con concepto sin equivalente?",
            "¿Por qué puede fallar?",
            "¿Qué señales sugieren problema?"
          ]
        }
      ]
    },
    {
      "id": "XEN-302-U05",
      "title": "Primer Contacto: fundamentos",
      "subtitle": "UNIDAD 05 · XEN-302",
      "blocks": [
        {
          "type": "p",
          "text": "Primer Contacto exige observar antes de intervenir y revisar datos, misión, Primera Directiva, equipo, traducción, protocolo y contingencias."
        },
        {
          "type": "callout",
          "label": "AUTORIDAD",
          "text": "Un cadete no inicia una política de Primer Contacto por decisión propia; participa dentro de una misión y supervisión."
        },
        {
          "type": "p",
          "text": "Una acción pequeña puede revelar tecnología, alterar poder interno o ser interpretada como compromiso."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Por qué observar antes de intervenir?",
            "¿Qué se revisa antes del contacto?",
            "¿Puede un cadete iniciarlo por su cuenta?",
            "¿Qué riesgos culturales puede crear una acción pequeña?",
            "¿Qué hacer cuando falta información?"
          ]
        }
      ]
    },
    {
      "id": "XEN-302-U06",
      "title": "Diplomacia básica",
      "subtitle": "UNIDAD 06 · XEN-302",
      "blocks": [
        {
          "type": "definition",
          "term": "Posición",
          "text": "Lo que una parte dice que quiere."
        },
        {
          "type": "definition",
          "term": "Interés",
          "text": "La necesidad o motivo que intenta proteger."
        },
        {
          "type": "heading",
          "text": "Desescalada"
        },
        {
          "type": "bullets",
          "items": [
            "Bajar tono",
            "Aclarar intención",
            "Ofrecer pausa",
            "Separar problema técnico de político",
            "Proponer opción reversible"
          ]
        },
        {
          "type": "callout",
          "label": "LÍMITES",
          "text": "Un cadete no puede prometer tratados, recursos importantes o compromisos políticos sin autoridad."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "Diferencia posición e interés.",
            "¿Qué busca una buena escucha?",
            "Nombra técnicas de desescalada.",
            "¿Qué no puede prometer un cadete?",
            "¿Por qué no acuerdo no siempre es fracaso?"
          ]
        }
      ]
    }
  ],
  "status": "developed_content"
}
