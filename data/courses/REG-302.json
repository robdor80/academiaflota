{
  "subject": "Regulaciones, Directiva Principal y responsabilidad",
  "code": "REG-302",
  "version": "1.1",
  "sourceRepository": "robdor80/Videojuego_StarTrek",
  "sourceCourse": "gameplay/careers/academy_path/curriculum/third_class/courses/REG-302/course.json",
