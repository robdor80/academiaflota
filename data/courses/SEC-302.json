  "modules": [
    {
      "id": "SEC-302-U01",
      "title": "Conciencia de amenaza",
      "subtitle": "UNIDAD 01 · SEC-302",
      "blocks": [
        {
          "type": "p",
          "text": "Conciencia de amenaza significa detectar cambios relevantes en entorno, personas, accesos, salidas, comunicaciones y estado de alerta."
        },
        {
          "type": "definition",
          "term": "Baseline",
          "text": "Lo normal en un contexto; permite reconocer anomalías sin convertir cada detalle en amenaza."
        },
        {
          "type": "callout",
          "label": "PROPORCIONALIDAD",
          "text": "Una señal aislada no demuestra hostilidad. Puede justificar observar, informar o aumentar preparación."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué significa conciencia de amenaza?",
            "¿Para qué sirve baseline?",
            "¿Una señal aislada demuestra hostilidad?",
            "¿Qué conviene identificar antes?",
            "¿Qué significa alerta proporcional?"
          ]
        }
      ]
    },
    {
      "id": "SEC-302-U02",
      "title": "Phaser: seguridad y límites",
      "subtitle": "UNIDAD 02 · SEC-302",
      "blocks": [
        {
          "type": "p",
          "text": "El phaser es una herramienta controlada: su uso depende de autorización, entrenamiento, configuración, contexto y reglas."
        },
        {
          "type": "heading",
          "text": "Principios de seguridad"
        },
        {
          "type": "bullets",
          "items": [
            "Comprobar estado",
            "Mantener control",
            "Seguir instrucciones",
            "No alterar configuraciones fuera de autorización",
            "Comunicar anomalías"
          ]
        },
        {
          "type": "callout",
          "label": "ACCESO ≠ AUTORIDAD",
          "text": "Tener acceso físico no autoriza su uso en cualquier situación."
        },
        {
          "type": "p",
          "text": "La respuesta debe ser proporcional al riesgo; una situación tensa no obliga a escalar."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué limita el uso?",
            "¿Qué principios de seguridad se enseñan?",
            "¿Acceso equivale a autoridad?",
            "¿Qué significa proporcionalidad?",
            "¿Por qué el uso debe ser trazable?"
          ]
        }
      ]
    },
    {
      "id": "SEC-302-U03",
      "title": "Seguridad a bordo",
      "subtitle": "UNIDAD 03 · SEC-302",
      "blocks": [
        {
          "type": "p",
          "text": "Seguridad a bordo incluye control de accesos, zonas restringidas, verificación de identidad, respuesta a incidencias y coordinación con Mando."
        },
        {
          "type": "heading",
          "text": "Ante una intrusión"
        },
        {
          "type": "numbered",
          "items": [
            "Confirmar lo observado",
            "Informar",
            "Proteger personas",
            "Evitar escalada innecesaria",
            "Seguir instrucciones"
          ]
        },
        {
          "type": "p",
          "text": "Una intervención sobre una persona depende de autoridad, riesgo, contexto y procedimiento."
        },
        {
          "type": "callout",
          "label": "PRESERVAR INFORMACIÓN",
          "text": "Una respuesta desordenada puede destruir registros, contexto o trazabilidad."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué forma seguridad a bordo?",
            "¿Por qué restringir zonas?",
            "¿Qué pasos siguen a intrusión?",
            "¿Qué limita una intervención?",
            "¿Por qué preservar información?"
          ]
        }
      ]
    },
    {
      "id": "SEC-302-U04",
      "title": "Equipo de salida",
      "subtitle": "UNIDAD 04 · SEC-302",
      "blocks": [
        {
          "type": "p",
          "text": "El equipo de salida depende de objetivo, entorno, duración, rol, riesgo y comunicaciones."
        },
        {
          "type": "heading",
          "text": "Responsabilidad individual"
        },
        {
          "type": "bullets",
          "items": [
            "Comprobar equipo",
            "Saber qué se lleva",
            "Informar fallos",
            "Conservarlo",
            "Devolver o registrar"
          ]
        },
        {
          "type": "p",
          "text": "Roles distintos priorizan herramientas distintas. Más equipo puede aumentar carga, complejidad y tiempo."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿De qué depende loadout?",
            "¿Por qué roles llevan equipo distinto?",
            "¿Qué incluye plan de comunicaciones?",
            "¿Qué responsabilidad tiene cada miembro?",
            "¿Por qué más equipo no siempre es mejor?"
          ]
        }
      ]
    },
    {
      "id": "SEC-302-U05",
      "title": "Supervivencia básica",
      "subtitle": "UNIDAD 05 · SEC-302",
      "blocks": [
        {
          "type": "p",
          "text": "En aislamiento, las prioridades pueden incluir seguridad inmediata, refugio, recursos, orientación, comunicación y señalización."
        },
        {
          "type": "heading",
          "text": "Recursos"
        },
        {
          "type": "bullets",
          "items": [
            "Agua",
            "Alimentos",
            "Energía",
            "Suministros",
            "Herramientas",
            "Capacidad médica"
          ]
        },
        {
          "type": "p",
          "text": "La orientación conserva posición conocida, dirección, referencias, ruta de retorno y puntos de reunión."
        },
        {
          "type": "callout",
          "label": "SEÑALIZACIÓN",
          "text": "Una señal de rescate debe ser detectable, compatible, persistente y segura para el contexto."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué prioridades aparecen?",
            "¿Qué debe proporcionar refugio?",
            "¿Qué recursos se controlan?",
            "¿Qué mantiene orientación?",
            "¿Qué hace útil una señal?"
          ]
        }
      ]
    },
    {
      "id": "SEC-302-U06",
      "title": "Equipo de salida bajo riesgo",
      "subtitle": "UNIDAD 06 · SEC-302",
      "blocks": [
        {
          "type": "p",
          "text": "Una formación organiza posiciones y responsabilidades según terreno, misión, visibilidad, riesgo, equipo y número de personas."
        },
        {
          "type": "heading",
          "text": "Cobertura y retirada"
        },
        {
          "type": "p",
          "text": "El equipo debe conservar capacidad de observar, comunicar, apoyar y retirarse. Retirarse puede ser correcto cuando cambia el riesgo o se supera la capacidad."
        },
        {
          "type": "callout",
          "label": "HERIDO",
          "text": "Un herido cambia ritmo, movilidad, recursos, prioridad y posibilidad de continuar."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿De qué depende una formación?",
            "¿Qué significa cobertura?",
            "¿Cuándo retirarse puede ser correcto?",
            "¿Cómo cambia la misión un herido?",
            "¿Por qué cohesión importa?"
          ]
        }
      ]
    }
  ],
  "status": "developed_content"
}
