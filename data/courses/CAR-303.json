  "modules": [
    {
      "id": "CAR-303-U01",
      "title": "Perfil académico actual",
      "subtitle": "UNIDAD 01 · CAR-303",
      "blocks": [
        {
          "type": "p",
          "text": "**El perfil académico reúne fortalezas, carencias, evidencia, preferencias, conducta y experiencias.**"
        },
        {
          "type": "callout",
          "label": "EVIDENCIA",
          "text": "Una fortaleza debe apoyarse en práctica, **observación** y resultados repetidos; una carencia no implica incompatibilidad automática."
        }
      ]
    },
    {
      "id": "CAR-303-U02",
      "title": "Qué exige cada rama",
      "subtitle": "UNIDAD 02 · CAR-303",
      "blocks": [
        {
          "type": "p",
          "text": "**Cada rama combina un tipo de trabajo, responsabilidades, competencias y estilo de servicio distinto.**"
        },
        {
          "type": "bullets",
          "items": [
            "**Mando: coordinación y liderazgo**",
            "Vuelo/Navegación: rutas y maniobra",
            "**Operaciones**: recursos y sistemas",
            "Ingeniería: energía y diagnóstico",
            "Seguridad/Táctica: protección y riesgo",
            "Ciencia/Sensores: medición y análisis",
            "Medicina: paciente y xenomedicina"
          ]
        }
      ]
    },
    {
      "id": "CAR-303-U03",
      "title": "Aptitud y preferencia",
      "subtitle": "UNIDAD 03 · CAR-303",
      "blocks": [
        {
          "type": "definition",
          "term": "Aptitud",
          "text": "**Capacidad demostrada o razonablemente desarrollable.**"
        },
        {
          "type": "definition",
          "term": "Preferencia",
          "text": "**Lo que el personaje quiere hacer.**"
        },
        {
          "type": "callout",
          "label": "SIN SCORE OCULTO",
          "text": "La recomendación puede orientar, pero no convertirse en una orden invisible."
        },
        {
          "type": "p",
          "text": "**Los requisitos objetivos sí pueden bloquear temporalmente una ruta hasta completar formación o recuperación.**"
        }
      ]
    },
    {
      "id": "CAR-303-U04",
      "title": "Objetivos de carrera",
      "subtitle": "UNIDAD 04 · CAR-303",
      "blocks": [
        {
          "type": "p",
          "text": "**Los objetivos de carrera marcan dirección, pero no crean puestos, promociones ni vacantes.**"
        },
        {
          "type": "p",
          "text": "Un mismo **objetivo** puede alcanzarse desde rutas distintas y puede cambiar, pausarse o abandonarse sin borrar la historia previa."
        },
        {
          "type": "callout",
          "label": "COHERENCIA",
          "text": "La trayectoria se valora con objetivo, acciones realizadas, requisitos y **oportunidades** reales."
        }
      ]
    },
    {
      "id": "CAR-303-U05",
      "title": "Entrevistas de orientación",
      "subtitle": "UNIDAD 05 · CAR-303",
      "blocks": [
        {
          "type": "p",
          "text": "**La entrevista de orientación ayuda a interpretar evidencia, intereses, dudas y oportunidades de desarrollo.**"
        },
        {
          "type": "heading",
          "text": "Apoyos posibles"
        },
        {
          "type": "bullets",
          "items": [
            "**Tutoría**",
            "**Optativas**",
            "Práctica adicional",
            "Rotación",
            "Curso cruzado",
            "Catch-up"
          ]
        },
        {
          "type": "callout",
          "label": "REGISTRO CUALITATIVO",
          "text": "La orientación no genera un porcentaje oculto de compatibilidad."
        }
      ]
    },
    {
      "id": "CAR-303-U06",
      "title": "Selección final",
      "subtitle": "UNIDAD 06 · CAR-303",
      "blocks": [
        {
          "type": "p",
          "text": "**La decisión final pertenece al jugador y se valida contra requisitos académicos, cualificaciones y restricciones reales.**"
        },
        {
          "type": "heading",
          "text": "Efectos de la elección"
        },
        {
          "type": "bullets",
          "items": [
            "**Horario**",
            "Clases",
            "Instructores",
            "Simulaciones",
            "Prácticas",
            "Compañeros",
            "**Cualificaciones**",
            "Candidatos a destino"
          ]
        },
        {
          "type": "callout",
          "label": "NO GARANTIZA DESTINO",
          "text": "La especialización influye en la trayectoria, pero no determina automáticamente el primer destino."
        },
        {
          "type": "p",
          "text": "Cambiar de rama después puede exigir tutoría, catch-up, evaluación o tiempo adicional sin borrar conocimientos previos."
        }
      ]
    }
  ],
  "status": "developed_content",
  "assessmentModel": "concept_driven_v2_1"
}
