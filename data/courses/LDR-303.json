{
  "subject": "Liderazgo y responsabilidad I",
  "code": "LDR-303",
  "version": "1.1",
  "sourceRepository": "robdor80/Videojuego_StarTrek",
  "sourceCourse": "gameplay/careers/academy_path/curriculum/third_class/courses/LDR-303/course.json",
