{
  "subject": "Juicio operativo, informes y debriefing",
  "code": "JDG-303",
  "version": "1.1",
  "sourceRepository": "robdor80/Videojuego_StarTrek",
  "sourceCourse": "gameplay/careers/academy_path/curriculum/third_class/courses/JDG-303/course.json",
  "sourceManual": "gameplay/careers/academy_path/study_materials/third_class/JDG-303/MANUAL_v1_0.md",
  "sourceRefs": [
    "gameplay/careers/academy_path/course_resolution.md",
    "gameplay/careers/academy_path/evaluation_model.json",
    "gameplay/careers/academy_path/academy_era_profiles.json",
    "gameplay/ship_operations/operational_event_log/README.md",
    "gameplay/careers/starfleet_service/professional_evidence_model.json"
  ],
  "modules": [
    {
      "id": "JDG-303-U01",
      "title": "Hechos, inferencias y supuestos",
      "subtitle": "UNIDAD 01 · JDG-303",
      "blocks": [
        {
          "type": "p",
          "text": "Hecho, inferencia, supuesto e hipótesis son capas distintas. Mezclarlas produce falsa certeza."
        },
        {
          "type": "definition",
          "term": "Hecho",
          "text": "Observación o registro con procedencia."
        },
        {
          "type": "definition",
          "term": "Inferencia",
          "text": "Conclusión razonada a partir de hechos."
        },
        {
          "type": "definition",
          "term": "Supuesto",
          "text": "Idea adoptada temporalmente sin evidencia suficiente."
        },
        {
          "type": "definition",
          "term": "Hipótesis",
          "text": "Explicación contrastable."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "Diferencia hecho e inferencia.",
            "¿Qué es supuesto?",
            "¿Qué distingue hipótesis?",
            "Nombra sesgos.",
            "¿Por qué expresar incertidumbre?"
          ]
        }
      ]
    },
    {
      "id": "JDG-303-U02",
      "title": "Riesgo y prioridad",
      "subtitle": "UNIDAD 02 · JDG-303",
      "blocks": [
        {
          "type": "p",
          "text": "El riesgo es contextual: combina probabilidad estimada, impacto, exposición, tiempo, capacidad de respuesta e incertidumbre."
        },
        {
          "type": "definition",
          "term": "Urgencia",
          "text": "Cuánto importa actuar ahora."
        },
        {
          "type": "definition",
          "term": "Reversibilidad",
          "text": "Capacidad de corregir o deshacer una decisión después."
        },
        {
          "type": "callout",
          "label": "SIN FALSA PRECISIÓN",
          "text": "Una probabilidad desconocida no debe convertirse en un número inventado."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué forma riesgo contextual?",
            "¿Por qué no inventar precisión?",
            "Diferencia impacto y probabilidad.",
            "Diferencia urgencia y gravedad.",
            "¿Por qué importa reversibilidad?"
          ]
        }
      ]
    },
    {
      "id": "JDG-303-U03",
      "title": "Decisión bajo información incompleta",
      "subtitle": "UNIDAD 03 · JDG-303",
      "blocks": [
        {
          "type": "p",
          "text": "Con información incompleta, esperar y actuar tienen costes. El cadete debe reconocer cuándo consultar, cuándo actuar y cuándo conservar opciones."
        },
        {
          "type": "definition",
          "term": "Umbral de decisión",
          "text": "Nivel de información o urgencia suficiente para actuar en ese contexto."
        },
        {
          "type": "heading",
          "text": "Consultas útiles"
        },
        {
          "type": "bullets",
          "items": [
            "Nuevo scan",
            "Opinión técnica",
            "Aclaración",
            "Informe",
            "Autoridad"
          ]
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué costes tiene esperar?",
            "¿Qué costes tiene actuar?",
            "¿Qué es umbral?",
            "¿Qué consultas reducen incertidumbre?",
            "¿Cuándo esperar puede ser correcto?"
          ]
        }
      ]
    },
    {
      "id": "JDG-303-U04",
      "title": "Informe operativo",
      "subtitle": "UNIDAD 04 · JDG-303",
      "blocks": [
        {
          "type": "p",
          "text": "Un informe operativo documenta hechos, acciones, resultado y pendientes."
        },
        {
          "type": "heading",
          "text": "Resultado"
        },
        {
          "type": "bullets",
          "items": [
            "Completado",
            "Parcial",
            "Fallido",
            "Cancelado",
            "Pendiente"
          ]
        },
        {
          "type": "callout",
          "label": "PENDIENTES",
          "text": "Cada pendiente debe conservar responsable, prioridad y siguiente acción."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué contiene informe?",
            "¿Por qué procedencia importa?",
            "¿Qué se registra de acción?",
            "¿Qué estados puede tener resultado?",
            "¿Qué debe tener pendiente?"
          ]
        }
      ]
    },
    {
      "id": "JDG-303-U05",
      "title": "Debrief profesional",
      "subtitle": "UNIDAD 05 · JDG-303",
      "blocks": [
        {
          "type": "definition",
          "term": "Hindsight bias",
          "text": "Juzgar una decisión pasada como si la persona hubiera conocido el resultado futuro."
        },
        {
          "type": "p",
          "text": "Evitar hindsight no elimina responsabilidad: se revisa qué se sabía, qué debía saberse, qué procedimiento existía y si la decisión era defendible."
        },
        {
          "type": "callout",
          "label": "LECCIÓN ÚTIL",
          "text": "Una lección debe ser específica y accionable, no «hacerlo mejor»."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué busca debrief?",
            "¿Qué es hindsight?",
            "¿Evitarlo elimina responsabilidad?",
            "¿Para qué analizar alternativas?",
            "¿Qué hace útil una lección?"
          ]
        }
      ]
    },
    {
      "id": "JDG-303-U06",
      "title": "Caso integrado",
      "subtitle": "UNIDAD 06 · JDG-303",
      "blocks": [
        {
          "type": "p",
          "text": "El caso integrado combina situación, decisión, consecuencia y documentación. Primero se reconstruye qué información existía en cada momento."
        },
        {
          "type": "callout",
          "label": "RESULTADO ≠ CALIDAD DE DECISIÓN",
          "text": "Una decisión bien fundada puede tener mal resultado y una mala decisión puede tener suerte."
        },
        {
          "type": "p",
          "text": "La documentación debe conservar hechos, separar inferencias y evitar reescribir la historia."
        },
        {
          "type": "heading",
          "text": "Autoevaluación"
        },
        {
          "type": "numbered",
          "items": [
            "¿Qué combina el caso?",
            "¿Por qué ordenar línea temporal?",
            "¿Con qué se compara una decisión?",
            "¿Resultado bueno implica decisión buena?",
            "¿Qué se revisa en documentación?"
          ]
        }
      ]
    }
  ],
  "status": "developed_content"
}
