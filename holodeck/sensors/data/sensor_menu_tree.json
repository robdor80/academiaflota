            "automatic_compensation",
            "send_to_science",
            "send_to_tactical"
          ]
        },
        {
          "id": "active_operations",
          "display_es": "Operaciones activas",
          "kind": "list",
          "tertiary": {
            "id": "operation_detail",
            "display_es": "Detalle de operación",
            "shows": [
              "operation_type",
              "target",
              "progress",
              "configuration",
              "partial_result",
              "resource_use"
            ],
            "context_actions": [
              "open_current_result",
              "cancel_operation",
              "request_additional_power"
            ]
          }
        }
      ]
