{
  "schema_version": "0.2.0",
  "console_id": "sensors",
  "status": "approved_v0.2_information_architecture",
  "principle": "detect_search_locate_measure_track_observe",
  "interaction_model": "gameplay/ship_operations/consoles/sensors/sensor_console_interaction_model.json",
  "contextual_actions_model": "gameplay/ship_operations/consoles/sensors/sensor_context_actions.json",
  "boundaries": {
    "owns": [
      "detection",
      "search",
      "localization",
      "measurement",
      "tracking",
      "sensor_filtering",
      "sensor_readout"
    ],
    "delegates": {
      "scientific_interpretation": "science",
      "weapons_and_fire_control": "tactical",
      "ship_course_plotting": "conn_navigation",
      "physical_repairs": "engineering",
      "shipwide_resource_priorities": "operations"
    }
  },
  "navigation_rules": {
    "primary_menu_count": 10,
    "one_primary_workspace_visible_at_a_time": true,
    "background_operations_continue_when_navigating": true,
    "context_can_cross_link_between_primary_menus": true,
    "context_prefill_allowed": true,
    "context_prefill_never_executes_automatically": true,
    "recommended_max_depth": 3,
    "deeper_navigation_requires_explicit_design_review": true
  },
  "root": [
    {
      "id": "status",
      "display_es": "Estado de sensores",
      "level": 1,
      "kind": "primary_menu",
      "secondary": [
        {
          "id": "general_status",
          "display_es": "Estado general",
          "kind": "view",
          "shows": [
            "system_state",
            "active_profile",
            "selected_array",
            "effective_capability",
            "alerts"
          ],
          "context_actions": [
            "run_self_test",
            "open_diagnostics"
          ]
        },
        {
          "id": "available_arrays",
          "display_es": "Matrices disponibles",
          "kind": "list",
          "tertiary": {
            "id": "array_detail",
            "display_es": "Detalle de matriz",
            "shows": [
              "availability",
              "integrity",
              "calibration",
              "supported_bands",
              "effective_range",
              "resolution",
              "current_load"
            ],
            "context_actions": [
              "select_array",
              "calibrate_array",
              "run_array_diagnostic",
              "request_engineering_support"
            ]
          }
        },
        {
          "id": "effective_range",
          "display_es": "Alcance efectivo",
          "kind": "view",
          "shows": [
            "short_range_capability",
            "long_range_capability",
            "current_environment_effect",
            "power_effect",
            "damage_effect"
          ],
          "context_actions": [
            "open_configuration_power",
            "request_additional_power"
          ]
        },
        {
          "id": "available_resolution",
          "display_es": "Resolución disponible",
          "kind": "view",
          "shows": [
            "current_resolution_ceiling",
            "active_constraints",
            "tradeoffs"
          ],
          "context_actions": [
            "open_configuration_resolution",
            "request_additional_power"
          ]
        },
        {
          "id": "allocated_power",
          "display_es": "Potencia asignada",
          "kind": "view",
          "shows": [
            "current_allocation",
            "usable_power",
            "temporary_grant",
            "request_status"
          ],
          "context_actions": [
            "open_configuration_power",
            "request_additional_power",
            "cancel_power_request"
          ]
        },
        {
          "id": "integrity_damage",
          "display_es": "Integridad / daños",
          "kind": "view",
          "shows": [
